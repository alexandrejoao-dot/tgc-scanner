# PIN de acesso à app (uso pessoal, sem contas) — escolhe uns números à tua escolha
ACCESS_PIN=

# Segredo usado para assinar os tokens de sessão
# (gera uma string aleatória longa, ex.: `openssl rand -hex 32`)
SESSION_SECRET=

# Chave grátis opcional em https://pokemontcg.io/ — sem ela a API funciona,
# mas com mais instabilidade/limites mais baixos.
POKEMONTCG_API_KEY=

# Supabase (projeto no supabase.com) — só no servidor, nunca a chave anon/publishable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
